# Django
DJANGO_SECRET_KEY=change-me-in-real-env
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=predictmaint
POSTGRES_USER=predictmaint
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# InfluxDB
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_INIT_USERNAME=admin
INFLUXDB_INIT_PASSWORD=change-me
INFLUXDB_ORG=predictmaint
INFLUXDB_BUCKET=predictmaint
INFLUXDB_TOKEN=change-me-generate-a-real-token

# Raw waveform storage (database.md §Raw Waveform Storage)
RAW_WAVEFORM_STORAGE_PATH=/data/raw-waveforms

# MQTT broker (mqtt-architecture.md)
MQTT_BROKER_HOST=mqtt-broker
MQTT_BROKER_PORT=1883
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_BROKER_USERNAME=predictmaint
MQTT_BROKER_PASSWORD=changeme
